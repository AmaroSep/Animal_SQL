# Production settings for docker-compose.prod.yml. Copy to .env.prod on the server
# (deploy/install.sh does it and generates the database password).

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=lab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bioterio

# ─── Web access ───────────────────────────────────────────────────────────────
# Address users type in the browser (used for CORS). Examples:
#   https://lab.example.org            (Cloudflare Tunnel)
#   http://lab-server:8080             (Tailscale, MagicDNS name)
PUBLIC_URL=http://localhost:8080
# Port of the web container on the server, and the address it listens on:
#   127.0.0.1 = only this machine (Cloudflare Tunnel runs inside the stack)
#   0.0.0.0   = every interface (needed to reach it through Tailscale)
WEB_PORT=8080
WEB_BIND=127.0.0.1
# true when PUBLIC_URL is https:// (session cookie never travels over plain http)
COOKIE_SECURE=false
SESSION_HOURS=12

# ─── Cloudflare Tunnel (optional, --profile tunnel) ──────────────────────────
TUNNEL_TOKEN=
# true only when users come in through the tunnel
TRUST_CF_HEADER=false

# ─── Backups ──────────────────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=30
TZ=America/Chicago
