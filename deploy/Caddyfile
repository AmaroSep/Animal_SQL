# Single entry point: the compiled frontend plus the API under /api.
# Caddy listens on plain HTTP inside the stack; HTTPS is provided by
# Cloudflare Tunnel (or Tailscale), so no certificate is managed here.
{
	auto_https off
	admin off
}

:80 {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API: strip the /api prefix and pass to FastAPI
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Built assets have a content hash in their name: cache them for good.
	# Everything else (index.html) must be revalidated so a new version shows up at once.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @notassets Cache-Control "no-cache"
	@notassets not path /assets/* /api/*

	# Frontend (single-page app): unknown paths fall back to index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
