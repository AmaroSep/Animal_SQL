# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Credentials for the database container.
# Change these values before deploying in any shared or production environment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=bioterio

# ─── Backend ──────────────────────────────────────────────────────────────────
# Full connection string used by the FastAPI container.
# Replace the password below with the value you set for POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/bioterio

# ─── Access / login ───────────────────────────────────────────────────────────
# Origins allowed to call the API with the session cookie (comma separated).
CORS_ORIGINS=http://localhost:5173
# true when served over HTTPS (production): the session cookie is then never sent over plain HTTP
COOKIE_SECURE=false
# Session length in hours
SESSION_HOURS=12
